{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "CAL_API_KEY",
    "GRAPH_TENANT_ID",
    "GRAPH_CLIENT_ID",
    "GRAPH_CLIENT_SECRET",
    "WITHDRAWAL_MAILBOX"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "test": {},
    "typecheck": {},
    "e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "widgets": {
      "cache": false,
      "passThroughEnv": ["CI"]
    }
  }
}
