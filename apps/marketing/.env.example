# Cal.com API key, optional. Left empty, the booker shows its "unconfigured" state.
# A key starts with cal_live_ and contains no whitespace; any other value stops the server at start.
CAL_API_KEY=

# Withdrawal function (/widerrufsrecht): Microsoft Graph app-only mail, set up per docs/withdrawal-mail.md.
# All four optional; unless all are set, the function runs "unconfigured" and asks for an e-mail instead.
# Tenant and client IDs are GUIDs, the secret contains no whitespace, the mailbox is one e-mail address;
# any other value stops the server at start.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
WITHDRAWAL_MAILBOX=
