# Cal.com API key, optional. Left empty, the booker shows its "unconfigured" state.
# A key starts with cal_live_ and contains no whitespace; any other value stops the server at start.
CAL_API_KEY=

# The payment page's connection to SkillForge: all three or none. Without them every invoice lookup is "not
# reachable"; part of them, a URL with a path, plain http to a host other than localhost or 127.0.0.1, or a value
# with whitespace stops the server at start.
# Locally: a SkillForge on http://localhost:8000 with a synthetic client. Never a hosted SkillForge from an agent session.
SKILLFORGE_API_URL=
SKILLFORGE_CLIENT_ID=
SKILLFORGE_CLIENT_SECRET=
