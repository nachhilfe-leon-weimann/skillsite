{
  "name": "skillsite",
  "version": "1.2.3",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test && vitest run",
    "smoke": "turbo run e2e",
    "storybook": "pnpm --filter @skillsite/ui storybook",
    "widgets": "turbo run widgets --filter=@skillsite/ui"
  },
  "devDependencies": {
    "@skillsite/config": "workspace:*",
    "js-yaml": "^5.5.0",
    "picomatch": "^2.3.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
