{
  "name": "skillsite",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test && vitest run",
    "storybook": "pnpm --filter @skillsite/ui storybook"
  },
  "devDependencies": {
    "@skillsite/config": "workspace:*",
    "prettier": "^3.9.9",
    "turbo": "^2.11.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
